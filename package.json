{
  "name": "cbms-naga-web-ai",
  "version": "0.1.0",
  "private": true,
  "description": "CBMS Naga City — pure-static, browser-only AI interpretation demo (duckdb-wasm + BYOK/local LLM)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite apps/chat-app",
    "prebuild": "node scripts/copy-data.mjs",
    "build": "vite build apps/chat-app",
    "start": "pnpm build && vite preview apps/chat-app",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev65.0",
    "@workspace/brand-config": "workspace:*",
    "@workspace/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.7"
  }
}
